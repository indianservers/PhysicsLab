<div class="modal fade" id="login_modal" tabindex="-1" aria-labelledby="exampleModalPopoversLabel" style="display: none;" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
       <div class="wrap-login100" style="background-image: url('/resources/img_new/Login.svg'); background-position: center;<!-- background-size: 460px; -->background-repeat: no-repeat;position:relative;">
 			 <button type="button" class="close" data-dismiss="modal" aria-label="Close">
           <i class="fa fa-times-circle" aria-hidden="true" style="color:red;"></i> 
        </button>
			
				<form class="login100-form validate-form" id="login_form" name="login_form" action = "/login" method="post" autocomplete="off" >
					<input type="hidden" id="username" name="username" autocomplete="off">
					<input type="hidden" id="password" name="password" autocomplete="off">
					<input type="hidden" id="captcha" name="captcha" autocomplete="off">
					
					<span class="login100-form-title p-b-34 p-t-27">
						<b>Login</b>
					</span>
					<div class="container" style="margin-top: 30px;">
						<div class="label-mar">
							<label for="uname"><b>Username</b></label>
							<input type="text" class="login_validate_css" placeholder="Username" name="user_id" id="user_id" style="padding: 3px 12px;" required autocomplete="off">
					    </div>
						<div class="label-mar">
							<label  for="psw"><b>Password</b></label>
							<input type="password" class="login_validate_css" maxlength="25" placeholder="Password" name="user_pwd" id="user_pwd" oncopy="return false" onpaste="return false" style="padding: 3px 12px;" required autocomplete="off">
	                        <span><i class="bi bi-eye-slash icon" id="togglePassword"></i>
	                        </span>
						</div> 
